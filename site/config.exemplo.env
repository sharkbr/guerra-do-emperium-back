# Configuracao do site - COPIE para config.env e preencha.
#
# O config.env NAO vai para o git (esta' no .gitignore), pela mesma regra do
# rathena/conf/import/: senha e segredo nao se versionam (CLAUDE.md secao 8).
#
# Para rodar:
#   set -a && . ./config.env && set +a && go run .

# Onde escutar. Atras do nginx, so' o localhost precisa alcancar.
SITE_ENDERECO=127.0.0.1:8080

# Banco - o MESMO do rAthena. O charset latin1 e' acrescentado pelo codigo
# se faltar aqui, porque esquece-lo e' defeito calado (CLAUDE.md secao 5).
SITE_BANCO_DSN=guerra:TROQUE_PELA_SENHA@tcp(127.0.0.1:3306)/guerra

# Assina o cookie de sessao E o hash dos documentos. Minimo 32 caracteres.
# Gere com:  openssl rand -hex 32
#
# ATENCAO: trocar este valor invalida os hashes de CPF/celular ja gravados.
# As contas continuam funcionando, mas o limite de uma conta por documento
# deixa de reconhecer quem ja se cadastrou - todo mundo ganha direito a mais
# uma. Ele entra no backup e nao se troca por capricho.
SITE_SEGREDO=

# Quantas contas cada documento pode ter.
SITE_MAX_CONTAS=1

# nenhuma  = a conta nasce na hora (modo beta)
# penelope = manda codigo por WhatsApp e espera a confirmacao
SITE_VERIFICACAO=nenhuma

# So' usados quando SITE_VERIFICACAO=penelope.
# O endpoint recebe POST com {"destino": "5511912345678", "mensagem": "..."}
SITE_PENELOPE_URL=
SITE_PENELOPE_TOKEN=
