- "lhz_diguts01.bmp"
+ ""
#: npc/quests/quests_lighthalzen.txt#1496 (mes)
- "[Digotz]"
+ ""
#: npc/quests/quests_lighthalzen.txt#1497 (mes)
- "Oh, it's been a while."
