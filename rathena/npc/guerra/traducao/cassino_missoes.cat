- "[Serin]"
+ ""
#: npc/quests/the_sign_quest.txt#5642 (mes)
- "Ah, "
+ ""
#: npc/quests/the_sign_quest.txt#5643 (mes)
- "~"
+ ""
#: npc/quests/the_sign_quest.txt#5644 (mes)
- "How is everything?"
+ ""
#: npc/quests/the_sign_quest.txt#5645 (mes)
- "Once again, I want to"
+ ""
#: npc/quests/the_sign_quest.txt#5646 (mes)
- "thank you for helping the"
+ ""
#: npc/quests/the_sign_quest.txt#5647 (mes)
- "poor souls in this place."
+ ""
#: npc/quests/the_sign_quest.txt#5648 (mes)
- "[Serin]"
+ ""
#: npc/quests/the_sign_quest.txt#5649 (mes)
- "Hmm...?"
+ ""
