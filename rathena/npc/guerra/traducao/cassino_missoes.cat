- "it's ruined! ^333333*Sob*^000000"
+ ""
#: npc/quests/the_sign_quest.txt#1581 (mes)
- "[Sir Jore]"
+ ""
#: npc/quests/the_sign_quest.txt#1582 (mes)
- "^333333*Sob*^000000"
+ ""
#: npc/quests/the_sign_quest.txt#1583 (mes)
- "I came to this town"
+ ""
#: npc/quests/the_sign_quest.txt#1584 (mes)
- "so I could focus on"
