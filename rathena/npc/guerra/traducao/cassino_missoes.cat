+ ""
#: npc/quests/quests_comodo.txt#201 (mes)
- "^3355FF20 Steel^000000"
+ ""
#: npc/quests/quests_comodo.txt#202 (mes)
- "^3355FF80 Feather^000000"
+ ""
#: npc/quests/quests_comodo.txt#203 (mes)
- "^3355FF800 Sticky Mucus^000000"
