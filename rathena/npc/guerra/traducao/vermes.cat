#
#   #: <arquivo>#<indice> (<contexto>)
#   - "<original em ingles>"     <- trava: se o upstream mudar, recusa
#   + "<traducao>"               <- vazio quer dizer "deixa em ingles"
#
# Arquivo em Latin-1 (ISO-8859-1). Ver PENDENCIAS.md, "Acentuacao no dialogo".

