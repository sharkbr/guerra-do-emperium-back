- "loo_smi"
+ ""
#: npc/re/instances/EddaHalfMoonInTheDaylight.txt#1546 (mes)
- "[Luwmin]"
+ ""
#: npc/re/instances/EddaHalfMoonInTheDaylight.txt#1547 (mes)
- "Listen to me. We will never be apart from one another."
+ ""
#: npc/re/instances/EddaHalfMoonInTheDaylight.txt#1548 (cutin)
- "pops_sim"
