+ ""
#: npc/re/instances/SarahAndFenrir.txt#849 (mes)
- "[Fenrith Fenrir]"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#850 (mes)
- "You arrived safely!"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#851 (mes)
- "The dangerous situation"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#852 (mes)
- "had me worried."
+ ""
#: npc/re/instances/SarahAndFenrir.txt#853 (mes)
- "It was difficult and dangerous work"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#854 (mes)
- "so I am grateful for your help."
+ ""
#: npc/re/instances/SarahAndFenrir.txt#855 (mes)
- "[Fenrir]"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#856 (mes)
- "I feel we will meet again"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#857 (mes)
- "but perhaps it is just my imagination?"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#858 (mes)
- "Mm.. that would be nice."
+ ""
#: npc/re/instances/SarahAndFenrir.txt#859 (mes)
- "[Fenrir]"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#860 (mes)
- "We worked well together"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#861 (mes)
- "so I hope we will meet again."
+ ""
#: npc/re/instances/SarahAndFenrir.txt#862 (mes)
- "And watch for Sarah,"
+ ""
#: npc/re/instances/SarahAndFenrir.txt#863 (mes)
- "harm can come your way as well."
+ ""
#: npc/re/instances/SarahAndFenrir.txt#865 (mes)
- "[Fenrir]"
+ ""
