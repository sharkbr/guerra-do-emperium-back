* text=auto

# O dono edita as vezes no Windows, as vezes no Mac: "text=auto" normaliza para
# LF no repositorio e devolve a quebra de linha nativa no checkout. Arquivos
# binarios (GRF, map_cache.dat, .dll) sao detectados e passam intactos.
#
# Excecoes onde a quebra de linha importa de verdade:
*.sln  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.go   text eol=lf

# O registro dos patches NAO e' so' um arquivo do repositorio: e' o proprio
# `lista.txt` que o servidor serve, enviado sem traducao pelo publica_patch.sh.
# Em LF ele chega ao cliente byte a byte igual ao que esta aqui. (O Atualizador
# tolera CRLF, mas um arquivo que atravessa tres maquinas nao deve depender
# disso.)
patcher/patches.txt text eol=lf
